# ==========================================================
# Production Docker Environment (.env) for VPS Setup
# ==========================================================

APP_NAME="Langit Profile Company"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==========================================================
# Database Configuration (Connected to Docker MariaDB/MySQL)
# ==========================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=langit_db
DB_USERNAME=langit_user
DB_PASSWORD=langit_secret_pass_2026
DB_ROOT_PASSWORD=root_secret_pass_2026

# Set true pada deploy pertama agar akun admin & 7 layanan ter-seed otomatis
SEED_ON_DEPLOY=true

# ==========================================================
# Cache, Session, & Queue Configuration (Connected to Redis)
# ==========================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================
# Mail Configuration (SMTP)
# ==========================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@langit.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# Docker Port Binding
# ==========================================================
HTTP_PORT=80
HTTPS_PORT=443
